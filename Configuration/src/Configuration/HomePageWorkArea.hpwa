<?xml version="1.0" encoding="UTF-8"?>
<hpwa:HomePageWorkArea xmlns:hpwa="http://g5.1c.ru/v8/dt/hpwa">
  <workingAreaTemplate>TwoColumnsVariableWidth</workingAreaTemplate>
  <columns>
    <items>
      <form>Document.Services.Form.ListForm</form>
      <height>10</height>
      <visibility>
        <common>true</common>
        <for>
          <role>Role.Administrator</role>
        </for>
        <for>
          <role>Role.CEO</role>
        </for>
        <for>
          <role>Role.PayrollAccountant</role>
        </for>
        <for>
          <role>Role.Accountant</role>
        </for>
      </visibility>
    </items>
    <items>
      <form>Report.TrialBalance.Form.ReportForm</form>
      <height>10</height>
      <visibility>
        <common>true</common>
        <for>
          <role>Role.Administrator</role>
        </for>
        <for>
          <role>Role.CEO</role>
        </for>
        <for>
          <role>Role.Technician</role>
        </for>
        <for>
          <role>Role.PayrollAccountant</role>
        </for>
      </visibility>
    </items>
    <items>
      <form>Report.RevenueByTechnician.Form.ReportForm</form>
      <height>10</height>
      <visibility>
        <common>true</common>
        <for>
          <role>Role.Administrator</role>
        </for>
        <for>
          <role>Role.Technician</role>
        </for>
        <for>
          <role>Role.PayrollAccountant</role>
        </for>
        <for>
          <role>Role.Accountant</role>
        </for>
      </visibility>
    </items>
  </columns>
  <columns>
    <items>
      <form>Document.GoodsReceipt.Form.ListForm</form>
      <height>10</height>
      <visibility>
        <common>true</common>
        <for>
          <role>Role.Administrator</role>
        </for>
        <for>
          <role>Role.CEO</role>
        </for>
        <for>
          <role>Role.PayrollAccountant</role>
        </for>
        <for>
          <role>Role.Accountant</role>
        </for>
      </visibility>
    </items>
  </columns>
</hpwa:HomePageWorkArea>
