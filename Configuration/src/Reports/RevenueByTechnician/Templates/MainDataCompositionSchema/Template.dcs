										<v8:content>Excellent</v8:content>
									</v8:item>
								</d7p1:labelText>
								<d7p1:toolTip xsi:type="v8:LocalStringType"/>
								<d7p1:labelArea>
									<d7p1:font xsi:type="v8ui:Font" kind="AutoFont"/>
									<d7p1:textColor>auto</d7p1:textColor>
